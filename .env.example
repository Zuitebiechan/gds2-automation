# GDS2 RPA Configuration
# Copy this file to .env and modify as needed

# Logging
LOG_LEVEL=INFO
LOG_TO_FILE=true

# GDS2 Configuration
GDS2_EXE_PATH=C:/Program Files/GDS2/GDS2.exe
GDS2_BACKEND=uia
GDS2_TIMEOUT=30

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000

# ==================== Vision Features ====================

# Screenshot Validation
# Enable screenshot comparison to verify UI operations worked
ENABLE_SCREENSHOT_VALIDATION=false
SCREENSHOT_DIR=screenshots

# VLM (Vision Language Model) Fallback
# When standard locators fail, use AI vision to find elements
ENABLE_VLM_FALLBACK=false
VLM_PROVIDER=claude
# Options: claude, openai

# API Keys for VLM providers
ANTHROPIC_API_KEY=your_anthropic_key_here
OPENAI_API_KEY=your_openai_key_here
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-5.4
OPENAI_REASONING_EFFORT=none

# OCR Verification
# Use OCR to verify text content on screen
ENABLE_OCR_VERIFICATION=false
OCR_PROVIDER=easyocr

# ==================== AI Exception Recovery (Phase 1) ====================

# Enable AI-powered exception recovery (default: false)
# When enabled, AI will analyze and recover from automation failures
ENABLE_AI_RECOVERY=false

# LLM Provider: "anthropic", "openai", or "zhipuai"
AI_RECOVERY_PROVIDER=zhipuai

# Model selection
# Anthropic: claude-3-5-sonnet-20241022 (recommended), claude-3-5-haiku-20241022 (cheaper)
# OpenAI: gpt-4o-mini (fast), gpt-4o (slower but more capable)
# ZhipuAI: glm-4-plus (recommended), glm-4-flash (faster), glm-4-air (cheaper)
AI_RECOVERY_MODEL=glm-4-plus

# API Keys (required if ENABLE_AI_RECOVERY=true)
# Note: ANTHROPIC_API_KEY and OPENAI_API_KEY are already defined above in Vision Features
ZHIPUAI_API_KEY=your_zhipuai_api_key_here

# Recovery behavior
AI_RECOVERY_CONFIDENCE=0.7        # Minimum confidence threshold (0.0-1.0)
AI_RECOVERY_MAX_RETRIES=2         # Max recovery attempts per anomaly
AI_RECOVERY_MAX_CALLS=3           # Max LLM calls per workflow session (cost control)
AI_RECOVERY_MAX_TOKENS=1024       # Max tokens per LLM response
AI_RECOVERY_TEMPERATURE=0.0       # LLM temperature (0.0 = deterministic)

# Timeout configuration
AI_RECOVERY_TIMEOUT_MULT=2.0      # Extend timeout to N times original (e.g., 30s -> 60s)
AI_RECOVERY_MAX_WAIT=120.0        # Maximum wait time in seconds

# Logging
AI_RECOVERY_LOG_DIR=logs/ai_recovery
AI_RECOVERY_LOG_DECISIONS=true    # Log all AI decisions for analysis

# ==================== Agentic Navigation (Phase 1) ====================

# LLM Configuration for Navigation Agent
LLM_PROVIDER=zhipuai  # Options: zhipuai, gemini, openai
LLM_MODEL=glm-4  # Model name (provider-specific)

# Knowledge Base
KNOWLEDGE_BASE_PATH=data/gds2_knowledge.lance

# Note: ZHIPUAI_API_KEY, GEMINI_API_KEY, OPENAI_API_KEY are already defined above

# HuggingFace Mirror (for China mainland access)
# Set this if huggingface.co is unreachable
HF_ENDPOINT=https://hf-mirror.com
HF_HUB_DISABLE_SYMLINKS_WARNING=1

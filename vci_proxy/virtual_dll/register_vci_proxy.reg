"Vendor"="VCI Proxy"
"ConfigApplication"=""
"FunctionLibrary"="C:\\Program Files (x86)\\VCI_Proxy\\virtual_j2534.dll"
"CAN"=dword:00000001
"ISO15765"=dword:00000001
"ISO14230"=dword:00000001
"ISO9141"=dword:00000001
"J1850PWM"=dword:00000001
"J1850VPW"=dword:00000001
